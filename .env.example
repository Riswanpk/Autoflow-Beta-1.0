PORT=3000
PUBLIC_BASE_URL=https://YOUR-RENDER-APP.onrender.com

# Meta WhatsApp Cloud API
WA_VERIFY_TOKEN=change-me
WA_ACCESS_TOKEN=EAAG...
WA_PHONE_NUMBER_ID=1234567890
WA_GRAPH_VERSION=v23.0
WA_BOOK_TEMPLATE_NAME=book_can
WA_TEMPLATE_LANG=en_US

# Demo pricing
CAN_PRICE=50
PLATFORM_FEE_PERCENT=2
# Local testing only. Set false before using real PayU.
MOCK_PAYU_PAYMENT=false
MOCK_PAYU_STATUS=SUCCESS

# PayU test checkout
PAYU_BASE_URL=https://test.payu.in/_payment
PAYU_KEY=
PAYU_SALT=
PAYU_EMAIL=
# JSON supplied after PayU enables split settlements and child merchants.
PAYU_SPLIT_REQUEST=
PAYU_MOCK_SPLIT=false
PAYU_TEST_PLATFORM_PERCENT=2

# Optional admin password for the demo
ADMIN_USER=admin
ADMIN_PASSWORD=demo123
