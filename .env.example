PORT=3000
PUBLIC_BASE_URL=https://YOUR-RENDER-APP.onrender.com

# Meta WhatsApp Cloud API
WA_VERIFY_TOKEN=change-me
WA_ACCESS_TOKEN=EAAG...
WA_PHONE_NUMBER_ID=1234567890
WA_GRAPH_VERSION=v23.0
WA_BOOK_TEMPLATE_NAME=book_can
WA_TEMPLATE_LANG=en_US

# Demo pricing
CAN_PRICE=50
PLATFORM_FEE_PERCENT=2
DECENTRO_FEE=3

# Decentro staging
DECENTRO_BASE_URL=https://staging.api.decentro.tech
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_CONSUMER_URN=
DECENTRO_MODULE_SECRET=
DECENTRO_PROVIDER_SECRET=
DECENTRO_MASTER_VIRTUAL_ACCOUNT=
DECENTRO_SECOND_UPI=
DECENTRO_SECOND_PAYEE_NAME=Partner
# Optional: if Decentro gives you a split settlement rule, put it here.
DECENTRO_SPLIT_SETTLEMENT_RULE_URN=

# Optional admin password for the demo
ADMIN_USER=admin
ADMIN_PASSWORD=demo123
