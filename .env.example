PORT=3000
PUBLIC_BASE_URL=https://YOUR-RENDER-APP.onrender.com
PAYU_SUCCESS_URL=https://YOUR-RENDER-APP.onrender.com/payu/success
PAYU_FAILURE_URL=https://YOUR-RENDER-APP.onrender.com/payu/failure

# Meta WhatsApp Cloud API
WA_VERIFY_TOKEN=change-me
WA_ACCESS_TOKEN=EAAG...
WA_PHONE_NUMBER_ID=1234567890
WA_GRAPH_VERSION=v23.0
WA_BOOK_TEMPLATE_NAME=book_can
WA_TEMPLATE_LANG=en_US

# Demo pricing
CAN_PRICE=50
PLATFORM_FEE_PERCENT=2
# Confirm the exact gateway rate in your PayU agreement.
PAYU_FEE_PERCENT=2
PAYU_GST_PERCENT=18

# PayU test checkout
PAYU_KEY=
PAYU_SALT=
PAYU_PAYMENT_URL=https://test.payu.in/_payment
PAYU_DEFAULT_EMAIL=customer@example.com
# Use the exact splitInfo JSON supplied by PayU. Tokens are replaced server-side.
# PAYU_SPLIT_INFO_JSON={"type":"split","splitId":"YOUR_SPLIT_ID","splitDetails":{"YOUR_CHILD_ID":{"amount":"{{BASE_AMOUNT}}"}}}

# Optional admin password for the demo
ADMIN_USER=admin
ADMIN_PASSWORD=demo123
